APP_NAME="AI Study Assistant API"
ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://study_user:study_password@postgres:5432/study_helper

JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=study-documents
S3_USE_SSL=false

MAX_UPLOAD_SIZE_MB=50

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX_NAME=study-helper
PINECONE_NAMESPACE=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBEDDING_DIMENSION=1536

CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
CHAT_MODEL=gpt-4o
AI_REQUEST_LIMIT=20/hour
